# Copy to .env and fill in. The backend reads these at startup.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for structured extraction. Defaults to claude-opus-4-8.
# For tighter latency/cost on this OCR-text extraction task you can switch to
# claude-sonnet-4-6 or claude-haiku-4-5 — both support structured outputs.
EXTRACTION_MODEL=claude-opus-4-8

# Per-image guards
MAX_FILES=10
MAX_FILE_MB=10
MAX_IMAGE_EDGE=1600

# Anthropic client timeout (seconds) — protects the per-image latency budget.
EXTRACTION_TIMEOUT_S=4.0

# OCR mean-confidence (0-100) below which we flag LOW_OCR_CONFIDENCE.
OCR_CONFIDENCE_THRESHOLD=55

# Comma-separated CORS origins for the Next.js dev server.
CORS_ORIGINS=http://localhost:3000
