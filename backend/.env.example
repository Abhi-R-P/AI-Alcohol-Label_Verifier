# Copy to .env and fill in. The backend reads these at startup.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for structured extraction. Defaults to claude-haiku-4-5 (fastest,
# to meet the <5s/image target). Switch to claude-sonnet-4-6 or claude-opus-4-8
# for higher accuracy at the cost of latency.
EXTRACTION_MODEL=claude-haiku-4-5

# Extraction strategy: "ocr" (Tesseract text -> Claude) or "vision" (image -> Claude).
EXTRACTION_MODE=ocr

# Per-image guards
MAX_FILES=10
MAX_FILE_MB=10
MAX_IMAGE_EDGE=1280

# Anthropic client timeout (seconds) — protects the per-image latency budget.
EXTRACTION_TIMEOUT_S=4.0

# OCR mean-confidence (0-100) below which we flag LOW_OCR_CONFIDENCE.
OCR_CONFIDENCE_THRESHOLD=55

# Comma-separated CORS origins for the Next.js dev server.
CORS_ORIGINS=http://localhost:3000
